# Copy to .env.local for local dev. NEVER commit .env.local.
# Without KV credentials, dev mode uses an in-memory store (resets on
# restart); production returns 503 from counter/intake routes.

# Upstash Redis — auto-injected on Vercel by the Marketplace integration.
# For local dev, copy the values from Vercel → Project → Settings →
# Environment Variables (either naming scheme works):
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Resend (resend.com → API Keys). Sandbox note: without a verified domain,
# Resend only delivers to the email you signed up with.
RESEND_API_KEY=

# Where Intake pitches land (with Resend sandbox: your Resend signup email).
INTAKE_TO_EMAIL=

# Secret for POST /api/admin/counters (generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))")
ADMIN_KEY=

# Show [PENDING] placeholders on deployed builds (set true on Vercel
# PREVIEW only, never Production).
# NEXT_PUBLIC_SHOW_PENDING=true
